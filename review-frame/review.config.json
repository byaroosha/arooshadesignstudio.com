// review.config.json
// Everything a designer fills in for one project lives in this file. index.html reads it on load.
// Lines that start with // are notes. The page skips them, so you can keep them or delete them.
// (Other JSON tools may not accept notes. Delete them if you need strict JSON.)
{
  "project": {
    "name": "Placeholder project",
    "description": "Example review with three placeholder screens. Swap in your own project name, design and updates."
  },

  // Reviewers. "role" is "UX" or "Stakeholder". Names are offered as suggestions in the comment form.
  "team": [
    { "name": "Ana Ruiz", "role": "UX" },
    { "name": "Jordan Lee", "role": "UX" },
    { "name": "Priya Shah", "role": "Stakeholder" },
    { "name": "Marcus Bell", "role": "Stakeholder" }
  ],

  // What sits inside the frame. "type" picks the source: "screens", "figma" or "code".
  // Keep exactly one "design" block. The "figma" and "code" examples are further down, switched off.

  // Type "screens": exported images, grouped into sub-flows, shown as a click-through prototype.
  //   image          path to the exported screen, relative to this file
  //   width, height  size of the image in pixels
  //   hotspots       optional clickable rectangles, in image pixels, each leading to another screen id
  "design": {
    "type": "screens",
    "flows": [
      {
        "name": "Sign in",
        "screens": [
          {
            "id": "welcome",
            "name": "Welcome",
            "image": "example/screens/01-welcome.svg",
            "width": 1440,
            "height": 900,
            "hotspots": [
              { "x": 120, "y": 440, "width": 220, "height": 56, "target": "sign-in", "label": "Get started" },
              { "x": 1256, "y": 24, "width": 120, "height": 40, "target": "sign-in", "label": "Sign in" }
            ]
          },
          {
            "id": "sign-in",
            "name": "Sign in form",
            "image": "example/screens/02-sign-in.svg",
            "width": 1440,
            "height": 900,
            "hotspots": [
              { "x": 528, "y": 486, "width": 384, "height": 56, "target": "dashboard", "label": "Sign in" },
              { "x": 520, "y": 578, "width": 150, "height": 34, "target": "welcome", "label": "Back to welcome" }
            ]
          }
        ]
      },
      {
        "name": "Dashboard",
        "screens": [
          {
            "id": "dashboard",
            "name": "Dashboard",
            "image": "example/screens/03-dashboard.svg",
            "width": 1440,
            "height": 1280,
            "hotspots": [
              { "x": 32, "y": 1192, "width": 184, "height": 44, "target": "welcome", "label": "Sign out" }
            ]
          }
        ]
      }
    ]
  },

  // Type "figma": a Figma prototype or file, shown in an iframe that fills the frame.
  // To use it, delete the "design" block above and remove the // from the four lines below.
  // For "url", use the address inside src="..." of Figma's embed code. A normal share link also works.
  //
  // "design": {
  //   "type": "figma",
  //   "url": "https://embed.figma.com/proto/FILE_KEY/FILE_NAME?node-id=1-2&embed-host=design-review"
  // },

  // Type "code": a local HTML page (a coded prototype), shown in an iframe that fills the frame.
  // To use it, delete the "design" block above and remove the // from the four lines below.
  //
  // "design": {
  //   "type": "code",
  //   "path": "example/prototype.html"
  // },

  // One entry per review, newest first.
  //   changes   the "What changed" list. "screen" is optional and points at a screen id.
  //   comments  two lists: "ux" (insight from the UX team) and "stakeholder".
  // Each comment: id, author, role, date, text, category, status, and optionally screen + x + y.
  //   category  "Accessibility", "Design system", "Content", "Flow" or "General"
  //   status    "open", "progress" or "resolved"
  //   screen    screen id, with x and y in percent of the screen (0 to 100), for a pinned spot.
  //             Leave all three out for a general comment.
  "updates": [
    {
      "date": "2026-11-09",
      "changes": [
        { "text": "Shortened the welcome headline and moved Get started above the fold.", "screen": "welcome" },
        { "text": "Sign in form: labels now sit above the fields.", "screen": "sign-in" },
        { "text": "Dashboard: summary cards moved above the chart.", "screen": "dashboard" },
        { "text": "Spacing and type sizes aligned to the design system on all screens." }
      ],
      "comments": {
        "ux": [
          {
            "id": "ux-1",
            "author": "Ana Ruiz",
            "role": "UX",
            "date": "2026-11-09",
            "text": "Get started uses the large primary button from the design system. No custom sizes on this screen.",
            "category": "Design system",
            "status": "open",
            "screen": "welcome",
            "x": 25.5,
            "y": 47.5
          },
          {
            "id": "ux-2",
            "author": "Jordan Lee",
            "role": "UX",
            "date": "2026-11-09",
            "text": "Labels sit above the inputs so they stay visible while typing. Error text still needs a contrast check.",
            "category": "Accessibility",
            "status": "progress",
            "screen": "sign-in",
            "x": 64.5,
            "y": 35.5
          },
          {
            "id": "ux-3",
            "author": "Ana Ruiz",
            "role": "UX",
            "date": "2026-11-09",
            "text": "All button labels now use sentence case.",
            "category": "Content",
            "status": "resolved"
          }
        ],
        "stakeholder": [
          {
            "id": "st-1",
            "author": "Priya Shah",
            "role": "Stakeholder",
            "date": "2026-11-10",
            "text": "Can the monthly total be the first card? It is the number we check most.",
            "category": "Flow",
            "status": "open",
            "screen": "dashboard",
            "x": 39.5,
            "y": 10.5
          },
          {
            "id": "st-2",
            "author": "Marcus Bell",
            "role": "Stakeholder",
            "date": "2026-11-10",
            "text": "Legal needs to review the sign in copy before this goes out.",
            "category": "Content",
            "status": "open"
          }
        ]
      }
    },
    {
      "date": "2026-11-02",
      "changes": [
        { "text": "First pass of the three screens: welcome, sign in and dashboard." }
      ],
      "comments": {
        "ux": [
          {
            "id": "ux-1",
            "author": "Jordan Lee",
            "role": "UX",
            "date": "2026-11-02",
            "text": "The welcome screen had two primary actions. Sign in is now the secondary one.",
            "category": "Flow",
            "status": "resolved",
            "screen": "welcome",
            "x": 88,
            "y": 9
          }
        ],
        "stakeholder": [
          {
            "id": "st-1",
            "author": "Priya Shah",
            "role": "Stakeholder",
            "date": "2026-11-03",
            "text": "Please add a way back from sign in to the welcome screen.",
            "category": "General",
            "status": "open"
          }
        ]
      }
    }
  ]
}
